NOVADOCK_ID=CLIPBOARD
NOVADOCK_NAME=Clippy
NOVADOCK_VERSION=0.1
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_DESCRIPTION=Session text history; click to restore, delete, clear or pause capture. Up to 8K per clip; nothing is saved to a history file.
NOVADOCK_LICENSE=MIT
NOVADOCK_FEATURES=meter,click,popup,badge
NOVADOCK_PROGRAM=Clipboard
NOVADOCK_VIEW=METER
NOVADOCK_ABI=1
NOVADOCK_OPTION=LIMIT|History entries|UINT|1,32|10
NOVADOCK_OPTION=BADGE|Show history count|BOOL||YES
