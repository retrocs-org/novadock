NOVADOCK_ID=NET
NOVADOCK_NAME=Network
NOVADOCK_VERSION=0.1
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_DESCRIPTION=Roadshow online/offline controls and live packet meters or graphs. Offline uses a launcher icon.
NOVADOCK_LICENSE=MIT
NOVADOCK_FEATURES=meter,graph,click,badge
NOVADOCK_PROGRAM=Network
NOVADOCK_VIEW=METER
NOVADOCK_ABI=1
NOVADOCK_OPTION=VIEW|Default view|CHOICE|METER,GRAPH|METER
NOVADOCK_OPTION=STACK|Network stack|CHOICE|AUTO,ROADSHOW|AUTO
NOVADOCK_OPTION=INTERFACE|Network interface|TEXT||AUTO
NOVADOCK_OPTION=DHCP_TIMEOUT|Connection timeout|UINT|10,300|60
NOVADOCK_OPTION=SAMPLING_OVERRIDE|Override sampling driver|BOOL||NO
NOVADOCK_OPTION=DEVICE|Sampling driver|TEXT||
NOVADOCK_OPTION=UNIT|Sampling unit|UINT|0,255|0
NOVADOCK_OPTION=SCALE_PPS|Meter scale PPS|UINT|1,1000000|250
NOVADOCK_OPTION=POLL_TICKS|Refresh ticks|UINT|10,250|50
NOVADOCK_OPTION=DEBUG_LOG|Debug log|BOOL||NO
