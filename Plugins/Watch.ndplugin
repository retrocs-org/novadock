NOVADOCK_ID=WATCH
NOVADOCK_NAME=WATCH
NOVADOCK_VERSION=0.1
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_DESCRIPTION=New and changed files in a drawer; bounded history and unread badges.
NOVADOCK_LICENSE=MIT
NOVADOCK_FEATURES=click,popup,badge,artwork
NOVADOCK_PROGRAM=Watch
NOVADOCK_VIEW=METER
NOVADOCK_ABI=5
NOVADOCK_MULTIPLE=YES
NOVADOCK_OPTION=LABEL|Tile label|TEXT||WATCH
NOVADOCK_OPTION=DRAWER|Watch drawer|FILE||
NOVADOCK_OPTION=INTERVAL|Check interval (seconds)|UINT|2,300|10
NOVADOCK_OPTION=ALERTS|Send dock notifications|BOOL||YES
NOVADOCK_OPTION=INCLUDE|Include names|TEXT||#?
NOVADOCK_OPTION=EXCLUDE|Ignore names|TEXT||
NOVADOCK_OPTION=QUIET|Quiet seconds for alerts|UINT|1,30|3
