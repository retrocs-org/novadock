NOVADOCK_ID=SENSORS
NOVADOCK_PROGRAM=Sensors
NOVADOCK_NAME=SENSOR
NOVADOCK_VERSION=0.3
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_DESCRIPTION=Read-only detected hardware sensors with selectable readings.
NOVADOCK_LICENSE=MIT
NOVADOCK_FEATURES=meter,click,popup,artwork
NOVADOCK_VIEW=METER
NOVADOCK_ABI=1
NOVADOCK_MULTIPLE=YES
NOVADOCK_OPTION=LABEL|Tile label|TEXT||SENSOR
NOVADOCK_OPTION=INTERVAL|Refresh seconds|UINT|2,60|5
NOVADOCK_OPTION=WARPTOOL|Warp diagnostic tool|FILE||C:WarpTool
NOVADOCK_OPTION=I2C|i2csensors.library provider|BOOL||YES
NOVADOCK_OPTION=RTC_MAX_AGE|RTC max age seconds|UINT|30,86400|120
NOVADOCK_OPTION=ZZ_TEMP|ZZ9000 FPGA temperature|BOOL||YES
NOVADOCK_OPTION=ZZ_CORE|ZZ9000 core voltage|BOOL||YES
NOVADOCK_OPTION=ZZ_AUX|ZZ9000 auxiliary voltage|BOOL||YES
NOVADOCK_OPTION=RTC_TEMP|RTC internal temperature|BOOL||YES
NOVADOCK_OPTION=RTC_CPU|RTC external CPU probe|BOOL||YES
NOVADOCK_OPTION=RTC_5V|RTC 5V supply|BOOL||YES
NOVADOCK_OPTION=RTC_BATT|RTC battery charge|BOOL||YES
NOVADOCK_OPTION=WARP_CPU|Warp CPU internal temperature|BOOL||YES
NOVADOCK_OPTION=WARP_EXT|Warp CPU external temperature|BOOL||YES
NOVADOCK_OPTION=WARP_ARM|Warp ARM temperature|BOOL||YES
NOVADOCK_OPTION=WARP_FPGA|Warp FPGA temperature|BOOL||YES
NOVADOCK_OPTION=WARP_5V|Warp 5V supply|BOOL||YES
NOVADOCK_OPTION=WARP_BATT|Warp battery voltage|BOOL||YES
NOVADOCK_OPTION=WARP_FAN|Warp fan output|BOOL||YES
