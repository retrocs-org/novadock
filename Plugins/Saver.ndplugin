NOVADOCK_ID=SAVER
NOVADOCK_PROGRAM=Saver
NOVADOCK_NAME=SAVER
NOVADOCK_VERSION=0.2
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_DESCRIPTION=Fullscreen animated scenes, Boing Ball and a configurable demo shuffle.
NOVADOCK_LICENSE=MIT
NOVADOCK_FEATURES=click,popup,artwork
NOVADOCK_ABI=1
NOVADOCK_OPTION=SCENE|Screen saver|CHOICE|Starfield,Boing ball,Bouncing ball,Blank,Copper waves,Vector show,Fireworks,Maze,Demo shuffle|Boing ball
NOVADOCK_OPTION=SPEED|Animation speed|CHOICE|Slow,Normal,Fast|Fast
NOVADOCK_OPTION=RENDER|Render size|CHOICE|Auto,Full,320 x 160,640 x 320|Full
NOVADOCK_OPTION=SHUFFLE_SECONDS|Shuffle seconds per scene|UINT|10,300|40
NOVADOCK_OPTION=SHUFFLE_STARS|Shuffle: Starfield|BOOL||YES
NOVADOCK_OPTION=SHUFFLE_BOING|Shuffle: Boing ball|BOOL||YES
NOVADOCK_OPTION=SHUFFLE_BALL|Shuffle: Bouncing ball|BOOL||YES
NOVADOCK_OPTION=SHUFFLE_BLANK|Shuffle: Blank|BOOL||NO
NOVADOCK_OPTION=SHUFFLE_COPPER|Shuffle: Copper waves|BOOL||YES
NOVADOCK_OPTION=SHUFFLE_VECTOR|Shuffle: Vector show|BOOL||YES
NOVADOCK_OPTION=SHUFFLE_FIREWORKS|Shuffle: Fireworks|BOOL||YES
NOVADOCK_OPTION=SHUFFLE_MAZE|Shuffle: Workbench maze|BOOL||YES
NOVADOCK_OPTION=DIAGNOSTICS|Performance diagnostics|BOOL||NO
