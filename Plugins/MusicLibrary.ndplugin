NOVADOCK_ID=MUSICLIB
NOVADOCK_PROGRAM=MusicLibrary
NOVADOCK_FEATURES=meter,click,popup,badge,artwork
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_LICENSE=MIT
NOVADOCK_DESCRIPTION=Independent cached music collections with format selection and filtering.
NOVADOCK_VERSION=0.2
NOVADOCK_NAME=MUSIC
NOVADOCK_VIEW=METER
NOVADOCK_ABI=1
NOVADOCK_MULTIPLE=YES
NOVADOCK_OPTION=LABEL|Tile label|TEXT||MUSIC
NOVADOCK_OPTION=DRAWER|Scan folder (recursive)|FILE||
NOVADOCK_OPTION=ICON|Tile icon|TEXT||Music
NOVADOCK_OPTION=ICONFILE|Custom icon or picture|FILE||
NOVADOCK_OPTION=PLAYER|Player (blank = Music default)|FILE||
NOVADOCK_OPTION=MP3|MP3 audio|BOOL||YES
NOVADOCK_OPTION=MOD|MOD modules|BOOL||YES
NOVADOCK_OPTION=XM|XM modules|BOOL||YES
NOVADOCK_OPTION=S3M|S3M modules|BOOL||YES
NOVADOCK_OPTION=IT|IT modules|BOOL||YES
NOVADOCK_OPTION=MED|MED / OctaMED modules|BOOL||YES
NOVADOCK_OPTION=SID|SID tunes|BOOL||YES
NOVADOCK_OPTION=WAV|WAV audio|BOOL||YES
NOVADOCK_OPTION=AIFF|AIFF audio|BOOL||YES
NOVADOCK_OPTION=OGG|Ogg audio|BOOL||YES
NOVADOCK_OPTION=FLAC|FLAC audio|BOOL||YES
