NOVADOCK_ID=TIMER
NOVADOCK_NAME=TIMER
NOVADOCK_VERSION=0.2.2
NOVADOCK_AUTHOR=NovaDock
NOVADOCK_DESCRIPTION=Countdown with pause, reset and a non-modal reminder.
NOVADOCK_LICENSE=MIT
NOVADOCK_FEATURES=meter,click,popup,artwork
NOVADOCK_PROGRAM=Timer
NOVADOCK_VIEW=METER
NOVADOCK_ABI=1
NOVADOCK_OPTION=SECONDS|Default seconds|UINT|1,86400|300
NOVADOCK_OPTION=MESSAGE|Reminder message|TEXT||Time is up
NOVADOCK_OPTION=BEEP|Flash screen on completion|BOOL||YES
