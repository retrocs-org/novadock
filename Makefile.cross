# macOS cross-build for Classic AmigaOS with vbcc + NDK 3.2 headers.
# The original Makefile is preserved for native Amiga builds.
VC ?= vc +aos68k -notmpfile
PYTHON ?= python3
COMPILE = $(PYTHON) scripts/compile-amiga.py --compiler "$(VC)" --
CFLAGS ?= -O -Iinclude -Iplugin_src/common -Iplugin_src/archive

# Cross-builds compile the same public source as native AmigaOS builds.
ND_DOCK_MAIN := src/novadock.c src/dock_save.c src/save_policy.c src/indicator.c
ND_PREFS_MAIN := prefs/novadockprefs.c

.PHONY: all clean

all: Plugins/Weather Plugins/ScreenSwitcher NovaDock NovaDockPrefs \
	Plugins/Clock Plugins/Eyes Plugins/Activity Plugins/Memory \
	Plugins/Network Plugins/MusicPlayer Plugins/DOpus4 \
	Plugins/ArchiveExtractor Plugins/Command Plugins/RunningApps Plugins/Trash Plugins/Games Plugins/MusicLibrary Plugins/Sensors Plugins/Christmas Plugins/Aquarium Plugins/Places Plugins/Saver Plugins/Aminet Plugins/Download Plugins/System Plugins/HASS Plugins/Actions Plugins/Alerts Plugins/Shelf Plugins/Watch Plugins/Logs Plugins/ToolTypes Plugins/Calc Plugins/SensorsI2C Plugins/AmiRocket Plugins/AmIRC Plugins/BitSkim Plugins/Clipboard Plugins/Mixer Plugins/Screenshot Plugins/ScreenMode Plugins/Script Plugins/Timer Plugins/Notes MakeIcon SetupStartup StartInstaller SaveConfig

NovaDock: include/nd_weather_art.h include/nd_weather_codes.h include/nd_screen_art.h src/novadock.c src/dock_arexx.c src/dock_draw.c src/dock_events.c src/dock_icons.c src/dock_input.c src/dock_launch.c src/dock_menu.c src/dock_plugins.c src/dock_popups.c src/dock_reload.c src/dock_save.c src/save_policy.c src/indicator.c src/dock_timers.c src/dock_window.c src/dock_internal.h src/config.c src/theme.c src/nd_options.c src/layout.c src/graph.c src/ilbm.c src/icon_mask.c src/interaction.c src/autohide.c src/eyes.c src/watchdog.c src/control_client.c src/nd_locale.c src/nd_media.c src/nd_tasks.c src/nd_folder.c plugin_src/archive/nd_archive.c include/nd_about.h include/nd_ilbm.h include/nd_icon_mask.h include/nd_watchdog.h include/nd_control_client.h include/nd_locale.h include/nd_strings.h include/nd_media.h include/nd_tasks.h include/nd_folder.h include/nd_version.h include/nd_save.h include/nd_indicator.h $(ND_DOCK_MAIN) include/nd_autohide.h include/nd_config.h include/nd_control.h include/nd_eyes.h include/nd_graph.h include/nd_interaction.h include/nd_layout.h include/nd_option_runtime.h include/nd_options.h include/nd_protocol.h include/nd_screennotify.h include/nd_theme.h plugin_src/archive/nd_archive.h include/nd_reply.h include/nd_calendar.h include/nd_search.h include/nd_plugin_labels.h include/nd_collection_icons.h include/nd_whdload_status.h include/nd_music_formats.h include/nd_sensors.h include/nd_christmas_art.h include/nd_aquarium_art.h include/nd_seasonal.h include/nd_places_saver_art.h include/nd_cpu_info.h include/nd_saver_modes.h src/nd_warp_detect.c include/nd_warp_detect.h src/nd_update.c src/nd_update_hash.c src/nd_update_native.c plugin_src/common/nd_panel.c include/nd_update.h include/nd_update_hash.h plugin_src/common/nd_panel.h plugin_src/weather/nd_fetch_worker.h include/nd_hass_art.h include/nd_reply.h include/nd_artwork.h include/nd_manifest.h include/nd_alerts.h include/nd_i2c_cache.h include/nd_volume.h
	$(COMPILE) $(CFLAGS) -o $@ $(ND_DOCK_MAIN) src/dock_arexx.c src/dock_draw.c src/dock_events.c src/dock_icons.c src/dock_input.c src/dock_launch.c src/dock_menu.c src/dock_plugins.c src/dock_popups.c src/dock_reload.c src/dock_timers.c src/dock_window.c src/config.c src/theme.c src/nd_options.c src/layout.c src/graph.c src/ilbm.c src/icon_mask.c src/interaction.c src/autohide.c src/eyes.c src/watchdog.c src/control_client.c src/nd_locale.c src/nd_media.c src/nd_tasks.c src/nd_folder.c plugin_src/archive/nd_archive.c src/nd_warp_detect.c src/nd_update.c src/nd_update_hash.c src/nd_update_native.c plugin_src/common/nd_panel.c src/nd_alerts.c src/nd_volume.c -lamiga

