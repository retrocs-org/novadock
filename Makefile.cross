	$(COMPILE) $(CFLAGS) -DND_PREFS_EMBEDDED -o $@ $(ND_PREFS_MAIN) prefs/novadockappearanceprefs.c prefs/nd_prefs_help.c prefs/novadockitemprefs.c prefs/novadocklauncherprefs.c prefs/novadockadditemprefs.c prefs/novadockpluginprefs.c src/nd_music_formats.c src/nd_sensors.c prefs/novadockmanagerprefs.c prefs/novadockdiagnosticsprefs.c prefs/novadockaboutprefs.c prefs/novadocklayoutprefs.c prefs/novadockdiscovery.c prefs/nd_package_install.c src/config.c src/theme.c src/nd_options.c src/layout.c src/layout_profiles.c src/prefs_layout.c src/control_client.c src/nd_manifest.c src/ilbm.c plugin_src/hass/nd_hass.c plugin_src/hass/nd_hass_client.c plugin_src/hass/nd_hass_ui.c plugin_src/common/nd_panel.c src/interaction.c src/nd_update.c src/nd_update_hash.c src/nd_update_native.c src/nd_i2c_cache.c -lamiga

