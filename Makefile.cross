clean:
	rm -f Plugins/Calc Plugins/ToolTypes
	rm -f Plugins/Watch Plugins/Logs
	rm -f Plugins/Aminet
	rm -f Plugins/Saver
	rm -f Plugins/Places
	rm -f Plugins/Aquarium
	rm -f Plugins/Download
	rm -f Plugins/System
	rm -f Plugins/Actions
	rm -f Plugins/Christmas
	rm -f Plugins/Sensors
	rm -f Plugins/MusicLibrary Plugins/Games
	rm -f Plugins/Weather
	rm -f Plugins/ScreenSwitcher
	rm -f Plugins/Notes
	rm -f Plugins/Timer
	rm -f SaveConfig
	-find compat -type f -name '*.o' -delete 2>/dev/null
	rm -f Plugins/Clipboard Plugins/AmIRC Plugins/Mixer Plugins/Screenshot Plugins/ScreenMode Plugins/Script
	rm -f NovaDock NovaDockPrefs NovaDockLauncherPrefs NovaDockPluginPrefs MakeIcon SetupStartup StartInstaller
	rm -f Plugins/Clock Plugins/Eyes Plugins/Activity Plugins/Memory Plugins/Network Plugins/MusicPlayer Plugins/DOpus4 Plugins/ArchiveExtractor Plugins/Command Plugins/RunningApps
	find src prefs plugin_src tools -type f -name '*.o' -delete
	rm -f Plugins/AmiRocket

